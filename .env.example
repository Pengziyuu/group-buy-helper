# 正式部署使用 Supabase URL 與公開金鑰；VITE_ 變數會暴露給瀏覽器，絕不能填入 service-role key 或 LINE secrets。
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# 團主LIFF，Endpoint為 /admin。
VITE_LIFF_ID=
# 住戶 LIFF，Endpoint 為網站根網址；現行分享網址是 /c/<slug>。
# 舊 /campaign/<slug> 與 /join/<invite> 僅為已分享網址的相容路徑，不能把 /join 當成入會憑證。
VITE_RESIDENT_LIFF_ID=
